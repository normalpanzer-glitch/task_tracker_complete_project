{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start backend",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "task-tracker-backend"
      }
    },
    {
      "label": "Start frontend",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "http.server",
        "5500",
        "--directory",
        "frontend"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "task-tracker-frontend"
      }
    },
    {
      "label": "Start Task Tracker",
      "dependsOn": [
        "Start backend",
        "Start frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Run backend tests",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "tests",
        "-v"
      ],
      "problemMatcher": []
    }
  ]
}